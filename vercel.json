{
  "rewrites": [
    {
      "source": "/api/pediatric-evaluation",
      "destination": "/api/create-stripe-invoice?mode=pediatric-interest"
    },
    {
      "source": "/api/pediatric-interest",
      "destination": "/api/create-stripe-invoice?mode=pediatric-interest"
    },
    {
      "source": "/label/:token",
      "destination": "/api/label/:token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
